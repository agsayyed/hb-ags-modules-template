{
  "name": "hb-ags-modules-template",
  "version": "v0.1.1",
  "description": "Template for creating HBStack modules",
  "type": "module",
  "private": true,
  "scripts": {
    "lint:js": "eslint --ext .js,.ts,.jsx,.tsx .",
    "lint:scss": "stylelint \"**/*.{css,scss}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules/**\"",
    "lint": "pnpm run lint:js && pnpm run lint:scss && pnpm run lint:md",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,css,scss,html,md,json,yaml}\"",
    "format:md": "markdownlint-cli2 --fix \"**/*.md\" \"!node_modules/**\" && prettier --write \"**/*.md\"",
    "format:hugo": "node ./scripts/preserve-gotemplate.js",
    "clean:md": "node ./scripts/clean-markdown.js",
    "sync-version": "node ./scripts/sync-version.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agsayyed/hb-ags-modules-template.git"
  },
  "keywords": [
    "hugo",
    "hbstack",
    "hugo-module",
    "hb-ags-modules"
  ],
  "author": "AbdulSayyed",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agsayyed/hb-ags-modules-template/issues"
  },
  "homepage": "https://github.com/agsayyed/hb-ags-modules-template#readme",
  "dependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "prettier-plugin-go-template": "^0.0.15",
    "stylelint": "^16.23.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "^5.9.2"
  }
}
